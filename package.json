{
	"name": "portfolio-website",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"fonts": "node scripts/copy-fonts.js",
		"portrait": "python3 scripts/pixel-portrait.py",
		"prepare": "svelte-kit sync && husky",
		"og": "bun scripts/og-images.js"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"prettier --write",
			"eslint --fix --no-warn-ignored"
		],
		"*.{css,json,md,html,yml,yaml}": [
			"prettier --write"
		]
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource/fira-code": "^5.3.0",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^26.2.0",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"firacode": "^6.2.0",
		"globals": "^17.11.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"satori": "^0.29.0",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.5",
		"typescript": "~6",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.1",
		"vitest": "^4.1.10"
	}
}
